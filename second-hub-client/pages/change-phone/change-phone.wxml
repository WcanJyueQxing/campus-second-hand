<view class="change-phone-container">
  <view class="form-card">
    <view class="form-item">
      <text class="form-label">手机号</text>
      <input
        class="form-input"
        type="number"
        value="{{phone}}"
        placeholder="请输入新手机号"
        bindinput="bindInput"
        data-field="phone"
        maxlength="11"
      />
    </view>
    <view class="form-divider"></view>

    <view class="form-item">
      <text class="form-label">验证码</text>
      <input
        class="form-input captcha-input"
        type="text"
        value="{{captchaCode}}"
        placeholder="请输入图形验证码"
        bindinput="bindInput"
        data-field="captchaCode"
        maxlength="4"
      />
      <image
        class="captcha-image"
        src="{{captchaBase64}}"
        mode="aspectFit"
        bindtap="refreshCaptcha"
      />
    </view>
  </view>

  <view class="tips">
    <text class="tip-text">点击图形验证码可刷新</text>
  </view>

  <view class="submit-btn-container">
    <button class="submit-btn" bindtap="submitForm">确认绑定</button>
  </view>
</view>