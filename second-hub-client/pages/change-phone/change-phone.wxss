.submit-btn-container {
  padding: 30rpx;
}

.submit-btn {
  /* 文字居中核心代码 */
  display: flex;
  align-items: center;
  justify-content: center;
  
  /* 还原你截图的样式 */
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #ff6b6b;
  border-radius: 40rpx; /* 圆角按钮 */
  background-color: #fff5f5;
  color: #ff4d4f;
  font-size: 30rpx;
  line-height: 1; /* 清除默认行高影响 */
}

/* 去掉按钮默认样式 */
.submit-btn::after {
  border: none;
}