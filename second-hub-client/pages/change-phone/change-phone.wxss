.change-phone-container {
  min-height: 100vh;
  background-color: #f4f7fc;
  padding: 20rpx;
}

.form-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 0 30rpx;
  margin-bottom: 30rpx;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
}

.form-label {
  width: 140rpx;
  font-size: 28rpx;
  color: #333;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.captcha-input {
  width: 200rpx;
}

.captcha-image {
  width: 160rpx;
  height: 64rpx;
  margin-left: 20rpx;
  border-radius: 8rpx;
}

.form-divider {
  height: 1rpx;
  background-color: #f0f0f0;
}

.tips {
  padding: 20rpx 30rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #999;
}

