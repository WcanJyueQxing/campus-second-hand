.address-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 140rpx;
}

/* 地址列表 */
.address-list {
  padding: 20rpx;
}

.address-item {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.address-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-right: 20rpx;
}

.phone {
  font-size: 28rpx;
  color: #666;
  flex: 1;
}

.default-tag {
  font-size: 22rpx;
  color: #409EFF;
  background-color: rgba(64, 158, 255, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.address-detail {
  display: block;
  font-size: 26rpx;
  color: #999;
  line-height: 36rpx;
  margin-bottom: 20rpx;
}

.address-actions {
  display: flex;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
}

.action-btn {
  font-size: 26rpx;
  padding: 8rpx 20rpx;
  margin-right: 16rpx;
  border-radius: 8rpx;
  transition: all 0.2s;
}

.action-btn:active {
  opacity: 0.7;
  transform: scale(0.95);
}

.default-btn {
  color: #409EFF;
  background-color: rgba(64, 158, 255, 0.1);
}

.is-default {
  color: #999;
  background-color: #f5f5f5;
}

.edit-btn {
  color: #666;
  background-color: #f5f5f5;
}

.delete-btn {
  color: #F56C6C;
  background-color: rgba(245, 108, 108, 0.1);
}

/* 空状态 */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
  text-align: center;
}

.empty-icon-text {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.empty-subtext {
  font-size: 26rpx;
  color: #999;
}

/* 底部添加按钮 */
.add-button-container {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx;
  background-color: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.05);
  z-index: 10;
}

.add-button {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.3);
  border: none;
}

.add-button:active {
  opacity: 0.9;
  transform: scale(0.98);
}

/* 适配不同屏幕 */
@media (min-width: 750rpx) {
  .address-list {
    padding: 40rpx;
  }

  .address-item {
    padding: 32rpx;
  }

  .add-button-container {
    padding: 32rpx;
  }

  .add-button {
    height: 96rpx;
    border-radius: 48rpx;
    font-size: 32rpx;
  }
}