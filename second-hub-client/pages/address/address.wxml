<view class="address-container">
  <!-- 地址列表 -->
  <view class="address-list" wx:if="{{addresses.length > 0}}">
    <view class="address-item" wx:for="{{addresses}}" wx:key="id">
      <view class="address-header">
        <text class="name">{{item.name}}</text>
        <text class="phone">{{item.phone}}</text>
        <text class="default-tag" wx:if="{{item.isDefault}}">默认</text>
      </view>
      <text class="address-detail">{{item.province}}{{item.city}}{{item.district}}{{item.detailAddress}}</text>
      <view class="address-actions">
        <text class="action-btn {{item.isDefault ? 'is-default' : 'default-btn'}}" bindtap="setDefault" data-id="{{item.id}}">{{item.isDefault ? '已默认' : '设为默认'}}</text>
        <text class="action-btn edit-btn" bindtap="editAddress" data-id="{{item.id}}">编辑</text>
        <text class="action-btn delete-btn" bindtap="deleteAddress" data-id="{{item.id}}">删除</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-container" wx:else>
    <text class="empty-icon-text">📍</text>
    <text class="empty-text">暂无收货地址</text>
    <text class="empty-subtext">点击下方按钮添加新地址</text>
  </view>

  <!-- 底部添加按钮 -->
  <view class="add-button-container">
    <button class="add-button" bindtap="addAddress">+ 新增收货地址</button>
  </view>
</view>