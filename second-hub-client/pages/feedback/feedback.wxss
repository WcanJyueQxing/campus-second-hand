.feedback-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 20rpx;
}

.feedback-type {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.type-title {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
}

.type-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.type-item {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: #666;
  background-color: #f5f5f5;
  border-radius: 24rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.type-item.selected {
  color: #667eea;
  background-color: rgba(102, 126, 234, 0.1);
  border-color: #667eea;
}

.type-item:active {
  opacity: 0.8;
}

.feedback-content {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  position: relative;
}

.content-title {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
}

.content-textarea {
  width: 100%;
  min-height: 240rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 44rpx;
  padding: 0;
  box-sizing: border-box;
}

.content-textarea::placeholder {
  color: #999;
}

.content-count {
  position: absolute;
  right: 24rpx;
  bottom: 32rpx;
  font-size: 24rpx;
  color: #999;
}

.feedback-contact {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.contact-title {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
}

.contact-input {
  width: 100%;
  font-size: 28rpx;
  color: #333;
  padding: 0;
}

.contact-input::placeholder {
  color: #999;
}

.feedback-submit {
  padding: 20rpx 0;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.3);
  border: none;
}

.submit-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

/* 适配不同屏幕 */
@media (min-width: 750rpx) {
  .feedback-container {
    padding: 40rpx;
  }

  .submit-btn {
    height: 96rpx;
    border-radius: 48rpx;
    font-size: 32rpx;
  }
}