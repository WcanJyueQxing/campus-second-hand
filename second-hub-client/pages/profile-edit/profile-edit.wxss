.save-btn-wrapper{
  padding: 30rpx;
}

.save-btn {
  /* 文字居中核心代码 */
  display: flex;
  align-items: center;
  justify-content: center;
  
  /* 还原你截图的样式 */
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #ff6b6b;
  border-radius: 40rpx; /* 圆角按钮 */
  background-color: #fff5f5;
  color: #ff4d4f;
  font-size: 30rpx;
  line-height: 1; /* 清除默认行高影响 */
}

.save-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

@media (min-width: 750rpx) {
  .profile-edit-container {
    padding: 40rpx;
    padding-bottom: 140rpx;
  }
  
  .edit-item {
    padding: 40rpx 36rpx;
  }
  
  .edit-label {
    width: 140rpx;
    font-size: 32rpx;
  }
  
  .value-wrapper {
    padding-left: 24rpx;
  }
  
  .avatar-wrapper {
    padding-left: 24rpx;
  }
  
  .avatar-img {
    width: 100rpx;
    height: 100rpx;
  }
  
  .edit-value {
    font-size: 32rpx;
  }
  
  .divider {
    margin: 0 36rpx;
  }
  
  .interests-wrapper {
    padding-left: 24rpx;
    gap: 20rpx;
  }
  
  .interest-tag {
    padding: 16rpx 28rpx;
    font-size: 26rpx;
  }
  
  .date-picker {
    height: 450rpx;
  }
  
  .save-btn {
    height: 100rpx;
    font-size: 32rpx;
    line-height: 100rpx;
  }
}