.profile-edit-container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx;
  padding-bottom: 120rpx;
}

.edit-card {
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.edit-item {
  display: flex;
  align-items: center;
  padding: 32rpx 30rpx;
  position: relative;
}

.edit-item:active {
  background-color: #f8f8f8;
}

.avatar-item {
  align-items: flex-start;
}

.edit-label {
  width: 120rpx;
  font-size: 28rpx;
  color: #333;
  flex-shrink: 0;
}

.value-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 20rpx;
}

.avatar-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 20rpx;
}

.avatar-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #f0f0f0;
}

.edit-value {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.edit-value.placeholder {
  color: #999;
}

.arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 2rpx solid #ccc;
  border-right: 2rpx solid #ccc;
  transform: rotate(45deg);
  flex-shrink: 0;
  margin-left: 16rpx;
}

.divider {
  height: 1rpx;
  background-color: #f0f0f0;
  margin: 0 30rpx;
}

/* 兴趣标签 */
.interests-item {
  flex-direction: column;
  align-items: flex-start;
  padding-bottom: 24rpx;
}

.interests-wrapper {
  width: 100%;
  padding-left: 20rpx;
  padding-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.interest-tag {
  padding: 12rpx 24rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #666;
  background-color: #fff;
  transition: all 0.2s ease;
}

/* 完全匹配截图的高亮效果 */
.interest-tag.selected {
  border-color: #409eff;
  color: #409eff;
  background-color: #e8f4ff;
}

.interest-tag:active {
  opacity: 0.8;
}

.placeholder-text {
  font-size: 24rpx;
  color: #999;
  padding: 12rpx 0;
}

.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 99;
}

.date-picker {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 400rpx;
  background: #fff;
  z-index: 100;
  border-top-left-radius: 20rpx;
  border-top-right-radius: 20rpx;
}

