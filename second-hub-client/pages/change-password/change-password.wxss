/* 按钮容器（可选，用于控制按钮宽度和位置） */
.submit-btn-container {
  padding: 20rpx 30rpx;
}

/* 按钮核心样式 */
.submit-btn {
  /* 文字居中（关键） */
  display: flex;
  align-items: center;
  justify-content: center;

  /* 还原截图样式 */
  width: 100%;
  height: 88rpx;
  border: none;
  border-radius: 44rpx; /* 完全圆角 */
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%); /* 蓝紫渐变 */
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 1; /* 清除小程序默认行高影响 */
}

/* 去掉小程序button默认边框 */
.submit-btn::after {
  border: none;
}
