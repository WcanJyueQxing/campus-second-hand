.change-password-container {
  min-height: 100vh;
  background-color: #f4f7fc;
  padding: 20rpx;
}

.form-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 0 30rpx;
  margin-bottom: 30rpx;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
}

.form-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #333;
}

.input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.toggle-btn {
  padding: 10rpx;
}

.toggle-icon {
  font-size: 36rpx;
}

.form-divider {
  height: 1rpx;
  background-color: #f0f0f0;
}

.tips {
  padding: 20rpx 30rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 10rpx;
}

.tip-item {
  font-size: 24rpx;
  color: #999;
  display: block;
  line-height: 1.6;
}

