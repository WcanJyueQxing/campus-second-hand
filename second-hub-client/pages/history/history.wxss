.btn-wrap {
  padding: 20rpx 30rpx;
}

.primary-btn {
  /* 文字水平+垂直居中 */
  display: flex;
  align-items: center;
  justify-content: center;

  /* 还原截图样式 */
  width: 100%;
  height: 88rpx;
  border: none;
  border-radius: 44rpx; /* 胶囊型圆角 */
  background: linear-gradient(90deg, #4facfe 0%, #00f2fe 100%); /* 蓝渐变 */
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 1; /* 清除小程序默认行高影响 */
  box-shadow: 0 8rpx 20rpx rgba(79, 172, 254, 0.3); /* 柔和阴影 */
}

/* 去掉小程序button默认边框 */
.primary-btn::after {
  border: none;
}