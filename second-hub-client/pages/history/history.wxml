<view class="container history-page">
  <!-- 头部 -->
  <view class="header">
    <view class="header-left">
      <text class="header-title">历史浏览</text>
    </view>
    <view class="header-right">
      <text class="clear-btn" bindtap="clearHistory" wx:if="{{historyList.length > 0}}">清空</text>
    </view>
  </view>

  <!-- 下拉菜单 -->
  <view class="filter-section" wx:if="{{historyList.length > 0}}">
    <view class="filter-item">
      <text class="filter-text">我浏览的</text>
      <text class="filter-arrow">▼</text>
    </view>
  </view>

  <!-- 历史记录按日期分组 -->
  <view class="history-container" wx:if="{{historyList.length > 0}}">
    <view wx:for="{{groupedHistory}}" wx:key="date">
      <view class="date-header">
        <text class="date-text">{{item.date}}</text>
      </view>
      <view class="history-grid">
        <view class="history-item" wx:for="{{item.items}}" wx:key="goodsId" bindtap="toGoodsDetail" data-id="{{item.goodsId}}">
          <image class="history-image" src="{{item.images[0] || '/images/default.png'}}" mode="aspectFill" />
          <text class="history-price">¥{{item.price}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:else>
    <view class="empty-icon">👁️</view>
    <view class="empty-title">暂无浏览历史</view>
    <view class="empty-desc">浏览商品后会自动记录在这里</view>
    <view class="btn-wrap">
      <button class="primary-btn" bindtap="toHome">去逛逛</button>
    </view>
  </view>
</view>