<view class="account-container">
  <view class="account-card">
    <view class="card-title">账号信息</view>
    <view class="account-item">
      <text class="item-label">用户ID</text>
      <text class="item-value">{{userId}}</text>
    </view>
    <view class="account-item no-border">
      <text class="item-label">注册时间</text>
      <text class="item-value">{{createTime}}</text>
    </view>
  </view>

  <view class="account-card">
    <view class="card-title">安全设置</view>
    <view class="account-item" bindtap="changePhone">
      <view class="item-left">
        <text class="item-label">手机号</text>
        <text class="item-desc">{{phone}}</text>
      </view>
      <text class="item-arrow">›</text>
    </view>
    <view class="account-item no-border" bindtap="changePassword">
      <view class="item-left">
        <text class="item-label">登录密码</text>
        <text class="item-desc">{{hasPassword ? '已设置' : '未设置'}}</text>
      </view>
      <text class="item-arrow">›</text>
    </view>
  </view>

  <view class="danger-zone">
    <view class="danger-item" bindtap="logoutDevice">
      <text class="danger-text">退出当前设备</text>
    </view>
  </view>
</view>