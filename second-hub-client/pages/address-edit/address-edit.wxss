.address-edit-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 20rpx;
}

/* 表单卡片 */
.form-card {
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.form-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  width: 140rpx;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  padding: 0;
}

.form-input::placeholder {
  color: #999;
}

.form-divider {
  height: 1rpx;
  background-color: #f5f5f5;
  margin: 0 24rpx;
}

.detail-item {
  align-items: flex-start;
}

.form-textarea {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  min-height: 80rpx;
  line-height: 40rpx;
  padding: 0;
}

.form-textarea::placeholder {
  color: #999;
}

/* 地区选择 */
.region-value {
  flex: 1;
  display: flex;
  align-items: center;
}

.region-text {
  font-size: 28rpx;
  color: #333;
}

.placeholder-text {
  font-size: 28rpx;
  color: #999;
}

.arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 2rpx solid #ccc;
  border-right: 2rpx solid #ccc;
  transform: rotate(45deg);
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* 默认地址卡片 */
.default-card {
  background-color: #fff;
  border-radius: 16rpx;
  margin-top: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.default-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
}

.default-label {
  font-size: 28rpx;
  color: #333;
}

.default-switch {
  transform: scale(0.9);
}

/* 保存按钮 */
.save-btn-container {
  margin-top: 60rpx;
  padding: 0 20rpx;
}

.save-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.3);
  border: none;
}

.save-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

/* 适配不同屏幕 */
@media (min-width: 750rpx) {
  .address-edit-container {
    padding: 40rpx;
  }

  .form-item {
    padding: 36rpx 32rpx;
  }

  .form-label {
    width: 160rpx;
    font-size: 32rpx;
  }

  .form-input {
    font-size: 32rpx;
  }

  .form-textarea {
    font-size: 32rpx;
  }

  .default-item {
    padding: 36rpx 32rpx;
  }

  .default-label {
    font-size: 32rpx;
  }

  .save-btn-container {
    margin-top: 80rpx;
    padding: 0 40rpx;
  }

  .save-btn {
    height: 96rpx;
    border-radius: 48rpx;
    font-size: 32rpx;
  }
}