<view class="container my-sold-page">
  <!-- 顶部导航栏 -->
  <view class="nav-bar">
    <view class="nav-left" bindtap="navigateBack">
      <text class="nav-back">←</text>
    </view>
    <view class="nav-title">我卖出的</view>
    <view class="nav-right"></view>
  </view>

  <!-- 订单列表 -->
  <view wx:if="{{list.length > 0}}" class="order-list" bindscrolltolower="loadMore">
    <block wx:for="{{list}}" wx:key="id">
      <view class="order-card" bindtap="toOrderDetail" data-id="{{item.id}}">
        <!-- 订单头部：买家信息 + 状态 -->
        <view class="order-header">
          <view class="buyer-info">
            <text class="buyer-avatar">{{item.buyerName ? item.buyerName.substr(0, 1) : '?'}}</text>
            <text class="buyer-name">{{item.buyerName || '未知买家'}}</text>
          </view>
          <view class="order-status">
            <text class="status-tag status-{{item._statusClass}}">{{item._statusText}}</text>
          </view>
        </view>

        <!-- 订单内容：商品信息 -->
        <view class="order-content">
          <view class="goods-image">
            <image src="{{item.goodsCover || '/images/default-avatar.png'}}" mode="aspectFill"></image>
          </view>
          <view class="goods-details">
            <view class="goods-title">{{item.goodsTitle || '商品详情'}}</view>
            <view class="goods-meta">
              <text class="goods-price">￥{{item.amount || '0.00'}}</text>
              <text class="order-time">{{item.createdAt}}</text>
            </view>
          </view>
        </view>

        <!-- 订单操作按钮 -->
        <view class="order-actions" catchtap="preventBubble">
          <block wx:if="{{item.orderStatus === 'PAID'}}">
            <button class="btn btn-primary" data-id="{{item.id}}" data-action="sellerConfirm" catchtap="doAction">确认发货</button>
          </block>
          <block wx:elif="{{item.orderStatus === 'BUYER_CONFIRMED'}}">
            <button class="btn btn-primary" data-id="{{item.id}}" data-action="sellerConfirm" catchtap="doAction">确认完成</button>
          </block>
          <block wx:elif="{{item.orderStatus === 'COMPLETED'}}">
            <text class="completed-text">交易已完成</text>
          </block>
          <block wx:elif="{{item.orderStatus === 'CANCELLED'}}">
            <text class="cancelled-text">订单已取消</text>
          </block>
          <block wx:elif="{{item.orderStatus === 'PENDING_PAYMENT'}}">
            <button class="btn btn-default" data-id="{{item.id}}" data-action="cancel" catchtap="doAction">取消订单</button>
          </block>
        </view>
      </view>
    </block>

    <!-- 加载更多提示 -->
    <view class="load-more" wx:if="{{hasMore}}">
      <text class="loading-text">加载中...</text>
    </view>
    <view class="load-more" wx:else>
      <text class="no-more-text">没有更多了</text>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:else>
    <view class="empty-icon">
      <text class="icon-text">📦</text>
    </view>
    <view class="empty-title">还没有订单</view>
    <view class="empty-desc">成交后会在这里查看订单状态</view>
  </view>
</view>