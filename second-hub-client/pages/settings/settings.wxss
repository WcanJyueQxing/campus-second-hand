.logout-container{
  padding: 30rpx;
}

.logout-button {
  /* 文字居中核心代码 */
  display: flex;
  align-items: center;
  justify-content: center;
  
  /* 还原你截图的样式 */
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #ff6b6b;
  border-radius: 40rpx; /* 圆角按钮 */
  background-color: #fff5f5;
  color: #ff4d4f;
  font-size: 30rpx;
  line-height: 1; /* 清除默认行高影响 */
}

/* 去掉按钮默认样式 */
.logout-button::after {
  border: none;
}

.logout-button:active {
  background-color: #ff4d4f;
  color: #fff;
  opacity: 0.9;
}

/* 适配不同屏幕 */
@media (min-width: 750rpx) {
  .settings-container {
    padding: 40rpx;
  }
  
  .section {
    margin-bottom: 40rpx;
  }
  
  .section-title {
    font-size: 26rpx;
    margin-bottom: 20rpx;
  }
  
  .settings-item {
    padding: 36rpx 32rpx;
  }
  
  .settings-label {
    font-size: 32rpx;
  }
  
  .logout-container {
    margin-top: 80rpx;
    padding: 0 40rpx;
  }
  
  .logout-button {
    height: 96rpx;
    line-height: 96rpx;
    border-radius: 48rpx;
    font-size: 32rpx;
  }
}