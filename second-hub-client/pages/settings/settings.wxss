.settings-container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx;
}

.section {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 15rpx;
  padding-left: 10rpx;
}

.settings-card {
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.settings-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 24rpx;
  position: relative;
}

.settings-item:active {
  background-color: #f8f8f8;
}

.settings-label {
  font-size: 28rpx;
  color: #333;
}

.settings-arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 2rpx solid #ccc;
  border-right: 2rpx solid #ccc;
  transform: rotate(45deg);
}

.settings-divider {
  height: 1rpx;
  background-color: #f0f0f0;
  margin: 0 24rpx;
}

