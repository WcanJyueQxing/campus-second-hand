.about-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 20rpx;
}

.about-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
  background-color: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.app-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.app-name {
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.app-version {
  font-size: 24rpx;
  color: #999;
}

.about-card {
  background-color: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.card-title {
  font-size: 26rpx;
  color: #999;
  padding: 20rpx 24rpx;
  background-color: #fafafa;
  border-bottom: 1rpx solid #f5f5f5;
}

.about-content {
  padding: 24rpx;
}

.about-text {
  display: block;
  font-size: 28rpx;
  color: #666;
  line-height: 44rpx;
  margin-bottom: 16rpx;
}

.about-text:last-child {
  margin-bottom: 0;
}

.contact-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.contact-item.no-border {
  border-bottom: none;
}

.contact-label {
  font-size: 28rpx;
  color: #333;
}

.contact-value {
  font-size: 28rpx;
  color: #999;
}

.copyright {
  text-align: center;
  padding: 40rpx 0;
}

.copyright text {
  font-size: 22rpx;
  color: #ccc;
}

/* 适配不同屏幕 */
@media (min-width: 750rpx) {
  .about-container {
    padding: 40rpx;
  }

  .about-header {
    padding: 80rpx 0;
  }

  .about-text {
    font-size: 30rpx;
  }
}