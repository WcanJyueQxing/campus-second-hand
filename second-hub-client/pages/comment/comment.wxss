.comment-page {
  min-height: 100vh;
  background: #f5f5f5;
}

/* 顶部导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 100rpx;
  padding: 0 30rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.08);
  position: sticky;
  top: 0;
  z-index: 100;
}

.nav-left {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back {
  font-size: 40rpx;
  color: #333333;
  font-weight: bold;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #1a2944;
}

.nav-right {
  width: 60rpx;
}

/* 商品信息 */
.goods-info {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #ffffff;
  margin: 20rpx 0;
  border-radius: 16rpx;
  margin: 20rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.goods-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f5f5f5;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.goods-image image {
  width: 100%;
  height: 100%;
}

.default-image {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
}

.default-icon {
  font-size: 60rpx;
}

.goods-details {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 120rpx;
}

.goods-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #1a2944;
  line-height: 40rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.goods-price {
  font-size: 30rpx;
  font-weight: 600;
  color: #ff4d4f;
  margin-top: 12rpx;
}

.score-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin: 20rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.desc {
  font-size: 28rpx;
  color: #999;
}

.star-group {
  display: flex;
  align-items: center;
  justify-content: center;
}

.star {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  color: #ddd;
  margin: 0 10rpx;
  transition: all 0.2s ease;
}

.star.active {
  background: linear-gradient(135deg, #ffc107 0%, #ff9800 100%);
  color: #fff;
  box-shadow: 0 0 20rpx rgba(255, 193, 7, 0.6);
}

.section-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #1a2944;
  margin-bottom: 20rpx;
}

/* 评价内容 */
.content-section {
  background: #ffffff;
  padding: 24rpx;
  margin: 20rpx 24rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  position: relative;
}

.content-input {
  width: 100%;
  min-height: 200rpx;
  font-size: 26rpx;
  color: #333333;
  line-height: 40rpx;
  padding: 16rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  background: #fafafa;
  resize: none;
}

.placeholder {
  color: #999999;
}

.char-count {
  position: absolute;
  bottom: 16rpx;
  right: 40rpx;
  font-size: 22rpx;
  color: #999999;
}

/* 提交按钮 */
.submit-section {
  padding: 30rpx;
}

.submit-btn {
  /* 文字居中核心代码 */
  display: flex;
  align-items: center;
  justify-content: center;
  
  /* 还原你截图的样式 */
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #ff6b6b;
  border-radius: 40rpx; /* 圆角按钮 */
  background-color: #fff5f5;
  color: #ff4d4f;
  font-size: 30rpx;
  line-height: 1; /* 清除默认行高影响 */
}

/* 去掉按钮默认样式 */
.submit-btn::after {
  border: none;
}

.submit-btn:disabled {
  background-color: #f5f5f5;
  color: #999999;
  border-color: #e0e0e0;
}

.submit-btn:active:not(:disabled) {
  background-color: #ffe8e8;
}