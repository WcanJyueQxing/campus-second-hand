<view class="notification-container">
  <view class="notification-card">
    <view class="card-title">消息提醒</view>
    <view class="notification-item">
      <view class="item-left">
        <text class="item-title">订单通知</text>
        <text class="item-desc">买家下单、付款、评价等通知</text>
      </view>
      <switch checked="{{notifications.order}}" bindchange="onSwitchChange" data-key="order" color="#667eea" />
    </view>
    <view class="notification-item">
      <view class="item-left">
        <text class="item-title">商品通知</text>
        <text class="item-desc">商品浏览、收藏、新上架等通知</text>
      </view>
      <switch checked="{{notifications.goods}}" bindchange="onSwitchChange" data-key="goods" color="#667eea" />
    </view>
    <view class="notification-item no-border">
      <view class="item-left">
        <text class="item-title">系统通知</text>
        <text class="item-desc">系统公告、安全提醒等通知</text>
      </view>
      <switch checked="{{notifications.system}}" bindchange="onSwitchChange" data-key="system" color="#667eea" />
    </view>
  </view>

  <view class="notification-card">
    <view class="card-title">推送设置</view>
    <view class="notification-item">
      <view class="item-left">
        <text class="item-title">允许推送</text>
        <text class="item-desc">开启后可接收消息推送</text>
      </view>
      <switch checked="{{notifications.pushEnabled}}" bindchange="onSwitchChange" data-key="pushEnabled" color="#667eea" />
    </view>
    <view class="notification-item">
      <view class="item-left">
        <text class="item-title">声音提醒</text>
        <text class="item-desc">收到通知时播放提示音</text>
      </view>
      <switch checked="{{notifications.sound}}" bindchange="onSwitchChange" data-key="sound" color="#667eea" />
    </view>
    <view class="notification-item no-border">
      <view class="item-left">
        <text class="item-title">震动提醒</text>
        <text class="item-desc">收到通知时震动提示</text>
      </view>
      <switch checked="{{notifications.vibrate}}" bindchange="onSwitchChange" data-key="vibrate" color="#667eea" />
    </view>
  </view>
</view>