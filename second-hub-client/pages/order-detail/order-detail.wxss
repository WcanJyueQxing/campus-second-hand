.order-detail-page {
  background: linear-gradient(180deg, #eef5ff 0%, #f4f7fc 220rpx);
  min-height: 100vh;
}

/* 顶部导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 100rpx;
  padding: 0 30rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  position: sticky;
  top: 0;
  z-index: 100;
}

.nav-left {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back {
  font-size: 40rpx;
  color: #333333;
  font-weight: bold;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #1a2944;
}

.nav-right {
  width: 60rpx;
}

/* 状态面板 */
.status-panel {
  margin-top: 16rpx;
  padding: 40rpx 30rpx;
  background: #ffffff;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.status-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.status-icon.tag--success {
  background: #f6ffed;
  color: #52c41a;
}

.status-icon.tag--warning {
  background: #fff7e6;
  color: #fa8c16;
}

.status-icon.tag--info {
  background: #e6f7ff;
  color: #1890ff;
}

.status-icon.tag--danger {
  background: #fff1f0;
  color: #ff4d4f;
}

.status-info {
  flex: 1;
}

.status-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a2944;
  margin-bottom: 8rpx;
}

.status-desc {
  font-size: 24rpx;
  color: #7a879b;
}

/* 信息面板 */
.order-info-panel,
.goods-info-panel,
.user-info-panel {
  margin-top: 16rpx;
  padding: 24rpx 30rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.panel-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a2944;
  margin-bottom: 20rpx;
}

/* 信息项 */
.info-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 24rpx;
  color: #7a879b;
}

.info-value {
  font-size: 24rpx;
  color: #1a2944;
  font-weight: 500;
}

/* 商品信息 */
.goods-item {
  display: flex;
  gap: 20rpx;
  padding: 16rpx 0;
}

.goods-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f5f5f5;
}

.goods-image image {
  width: 100%;
  height: 100%;
}

.goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goods-title {
  font-size: 26rpx;
  font-weight: 500;
  color: #1a2944;
  line-height: 36rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  margin-bottom: 12rpx;
}

.goods-price {
  font-size: 28rpx;
  font-weight: 600;
  color: #ff4d4f;
}

/* 底部操作栏 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  padding: 20rpx 30rpx;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.08);
  z-index: 99;
}

.action-buttons {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
}

.action-btn {
  margin: 0;
  min-width: 160rpx;
  height: 68rpx;
  line-height: 68rpx;
  font-size: 26rpx;
  border-radius: 12rpx;
  padding: 0 20rpx;
}

.primary-btn {
  background: #2f7df6;
  color: #ffffff;
  border: none;
}

.ghost-btn {
  background: #ffffff;
  color: #6d7d95;
  border: 1rpx solid #e0e0e0;
}

.danger-btn {
  background: #ffffff;
  color: #ff4d4f;
  border: 1rpx solid #ff4d4f;
}

/* 状态图标 */
.status-icon::before {
  content: '✓';
  font-weight: bold;
}

.status-icon.tag--warning::before {
  content: '!';
}

.status-icon.tag--info::before {
  content: 'i';
}

.status-icon.tag--danger::before {
  content: '×';
}