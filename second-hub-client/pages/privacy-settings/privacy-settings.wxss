.privacy-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 20rpx;
}

.privacy-card {
  background-color: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.card-title {
  font-size: 26rpx;
  color: #999;
  padding: 20rpx 24rpx;
  background-color: #fafafa;
  border-bottom: 1rpx solid #f5f5f5;
}

.privacy-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.privacy-item.no-border {
  border-bottom: none;
}

.item-left {
  flex: 1;
}

.item-title {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.item-desc {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.item-arrow {
  font-size: 36rpx;
  color: #ccc;
  margin-left: 16rpx;
}

/* 适配不同屏幕 */
@media (min-width: 750rpx) {
  .privacy-container {
    padding: 40rpx;
  }

  .privacy-item {
    padding: 32rpx;
  }
}